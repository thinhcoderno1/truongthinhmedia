# Copy to .env.local. An empty API URL enables clearly labeled demo content.
WORDPRESS_API_URL=
# e.g. https://cms.truongthinhmedia.com/wp-json/wp/v2
WORDPRESS_IMAGE_HOSTS=
# Additional HTTPS CDN hostnames, comma-separated. Required at build time.
SITE_URL=https://truongthinhmedia.com
ALLOW_INDEXING=false
# Enable only after connecting the real CMS and reviewing the public content.
REVALIDATE_SECRET=
# At least 32 characters. Server-only; never prefix with NEXT_PUBLIC_.
CONTACT_EMAIL=
CONTACT_FACEBOOK_URL=
CONTACT_LINKEDIN_URL=
